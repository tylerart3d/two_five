  "personNotes": [
    {
      "personId": "person-d-r-marcum",
      "text": "D. R. Marcum and D. E. Marcum likely refer to the same officer. The February 22 roster lists D. R. Marcum as Echo Company commander; the March 18 change of command names D. E. Marcum as the outgoing commander. The differing initials appear in the original documents and likely reflect a typographical error.",
      "status": "Probable identity match; not conclusively confirmed",
